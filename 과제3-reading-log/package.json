{
  "name": "assignment3-reading-log",
  "version": "1.0.0",
  "description": "고급웹프로그래밍 과제 3 — 독서 기록 REST API 서버 (데이터베이스 연동)",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/app.ts",
    "check": "tsc --noEmit",
